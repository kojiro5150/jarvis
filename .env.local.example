# Copy this file to .env.local for local development.
# .env.local is git-ignored and never committed.
#
# In production (Vercel), set these under:
# Project Settings -> Environment Variables
# Never expose server secrets with a NEXT_PUBLIC_ prefix.

# Dashboard presentation selection. Omit or set LEGACY to preserve the production default.
# Set GOVERNED to expose the governed presentation; set LEGACY to roll back without code changes.
# Invalid values fail rendering rather than silently selecting a path.
# DASHBOARD_PRESENTATION_MODE=LEGACY

# Required — powers the governed /api/lighter/chat conversational runtime and bounded model-backed reasoning.
ANTHROPIC_API_KEY=sk-ant-...

# Reserved for optional voice integration. Leave blank unless a voice path explicitly uses it.
ELEVENLABS_API_KEY=

# Durable execution audit persistence.
# When both URL and server secret are present, execution audit records use Supabase.
# When neither is present, JARVIS falls back to local append-only JSONL storage.
# Partial configuration fails loudly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Compatibility only for projects still using the legacy key/variable name.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional JSONL path override when Supabase is not configured.
# JARVIS_EXECUTION_AUDIT_PATH=.data/execution-audit.jsonl

# --- Connectors (lib/connectors/*.ts) ---
# Calendar, Gmail and Drive all have real Google-backed connectors.
# Leave these unset (recommended) — each factory uses Google when stored
# Google tokens are present and otherwise falls back to its local connector.
# Force a specific provider only when you intentionally need to override
# that automatic behaviour.
# CALENDAR_CONNECTOR=local
# CALENDAR_CONNECTOR=google
# GMAIL_CONNECTOR=local
# GMAIL_CONNECTOR=google
# DRIVE_CONNECTOR=local
# DRIVE_CONNECTOR=google

# Governed identified-message Gmail reads fail closed unless this server-only
# path names a readable, valid content-retrieval policy. This tracked policy is
# intentionally bounded to subject release for local development/demo use.
CONTENT_RETRIEVAL_POLICY_PATH=config/content-retrieval-policy.dev.json

# --- Google OAuth (Calendar + Gmail + Drive) ---
# From a Google Cloud OAuth 2.0 Web Application client with the Calendar,
# Gmail and Drive APIs enabled. One consent flow requests:
# - calendar.readonly for governed Calendar reads;
# - calendar.events for the narrowly governed Calendar event-move capability;
# - gmail.readonly for governed Gmail search/read;
# - drive.readonly for governed Drive search and identified Google Doc reads.
# Gmail and Drive remain read-only at the governed action layer. Google does
# not retroactively add newly requested scopes to an existing grant, so
# reconnect/re-consent after a scope migration when required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
