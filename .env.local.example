# Copy this file to .env.local for local development.
# .env.local is git-ignored and never committed.
#
# In production (Vercel), set these under:
# Project Settings -> Environment Variables
# Never expose server secrets with a NEXT_PUBLIC_ prefix.

# Required — powers /api/chat and controlled specialist execution.
ANTHROPIC_API_KEY=sk-ant-...

# Not used yet in Phase 1 (voice output lands in a later phase).
# Reserved so the variable name is settled ahead of time.
ELEVENLABS_API_KEY=

# Durable execution audit persistence.
# When both URL and server secret are present, execution audit records use Supabase.
# When neither is present, JARVIS falls back to local append-only JSONL storage.
# Partial configuration fails loudly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Compatibility only for projects still using the legacy key/variable name.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional JSONL path override when Supabase is not configured.
# JARVIS_EXECUTION_AUDIT_PATH=.data/execution-audit.jsonl

# --- Connectors (lib/connectors/*.ts) ---
# Drive: local only in this phase. Setting this to anything other than
# "local" makes that connector throw on purpose (fails loudly instead of
# silently) until its real implementation exists.
# DRIVE_CONNECTOR=local

# Calendar and Gmail: real Google-backed connectors are implemented for
# both. Leave these unset (recommended) — they default to "auto", which
# uses Google once you've connected via the dashboard's "Connect
# Calendar" / "Connect Gmail" buttons (both hit the same
# GET /api/auth/google/start — one OAuth grant covers both services) and
# fall back to local data until then. Force a specific provider only if
# you need to override that behavior.
# CALENDAR_CONNECTOR=auto
# CALENDAR_CONNECTOR=local
# CALENDAR_CONNECTOR=google
# GMAIL_CONNECTOR=auto
# GMAIL_CONNECTOR=local
# GMAIL_CONNECTOR=google

# --- Google OAuth (Calendar + Gmail, both read-only) ---
# From a Google Cloud OAuth 2.0 Web Application client with the Calendar
# API and Gmail API both enabled. Requests calendar.readonly and
# gmail.readonly together in one consent screen — no write/send/modify
# access to either, no Drive scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
